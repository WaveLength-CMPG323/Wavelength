# Copy this file to .env and fill in real values. Never commit .env itself.

# From your Spotify Developer Dashboard app
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a "Redirect URI" registered in the Spotify Dashboard.
# Spotify's policy requires 127.0.0.1 (not "localhost") for a non-HTTPS
# redirect URI - see https://developer.spotify.com/documentation/web-api/concepts/redirect_uri
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Where the frontend runs, used to redirect the browser after login.
# Keep this on the SAME host (127.0.0.1) as SPOTIFY_REDIRECT_URI above -
# see frontend/vite.config.ts, which binds the dev server to 127.0.0.1 for
# exactly this reason. Mixing "localhost" and "127.0.0.1" between the two
# breaks the session cookie (browsers treat them as different sites).
FRONTEND_URL=http://127.0.0.1:5173

# Port for this Express server
PORT=3000

# Any long random string - used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_random_string

# Postgres connection string (from your team's hosted Postgres instance)
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@host:5432/dbname
