# Copy this file to .env and adjust if your backend runs somewhere else.
# Used by src/lib/api.ts and src/lib/socket.ts.
#
# Must use the exact same host (127.0.0.1) as the backend - see
# vite.config.ts. Mixing "localhost" and "127.0.0.1" between the two
# breaks the session cookie, since browsers treat them as different sites.
VITE_API_URL=http://127.0.0.1:3000
